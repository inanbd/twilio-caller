{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=twilio-caller.db"
  },
  "PublicBaseUrl": "",
  "Security": {
    "MasterKey": "",
    "SessionSigningKey": "",
    "Issuer": "twilio-caller",
    "Audience": "twilio-caller-app",
    "SessionDays": 30
  },
  "Voice": {
    "TokenMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  }
}

# Copy to .env and fill in before running docker compose up.

# The https URL Twilio can reach this backend at. During development, run
#   ngrok http 8080
# and paste the forwarding URL here. Changing it means re-saving number routing
# in the app, because the webhook URLs are derived from it.
PUBLIC_BASE_URL=https://your-backend.example.com

# Encrypts the Twilio API key secret at rest. Must decode to exactly 32 bytes.
#   openssl rand -base64 32
MASTER_KEY=

# Signs the app's session tokens. At least 32 characters.
#   openssl rand -base64 48
SESSION_SIGNING_KEY=

# Origin of the Flutter web build, if you serve one. "*" allows any origin.
WEB_ORIGIN=*
